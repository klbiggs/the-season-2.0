# Optional dev-only Gemini API key. Get key from: https://aistudio.google.com/apikey
# Copy this file to server/.env and replace the placeholder.
GEMINI_API_KEY=AIzaSy_replace_with_your_key

# P26 (G5): embedding-provider selector for /api/llm/embed. Leave unset or set to
# "gemini" (the only live provider at v1.5 — reuses GEMINI_API_KEY). Any other
# value is a startup error until a second provider (Voyage/OpenAI) is wired.
# EMBED_PROVIDER=gemini
