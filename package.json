{
  "name": "the-season",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n vite,server -c blue,magenta \"pnpm dev:vite\" \"pnpm dev:server\"",
    "dev:vite": "vite",
    "dev:server": "node --env-file=server/.env --import=tsx server/index.ts",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests server",
    "lint:fix": "biome check --write src tests server",
    "lint:boundaries": "eslint --config eslint.config.js src server",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "e2e": "playwright test",
    "generate:map": "node scripts/generate-map.mjs"
  },
  "dependencies": {
    "dexie": "~4.0.10",
    "framer-motion": "~12.0.0",
    "immer": "~10.1.1",
    "react": "~19.0.0",
    "react-dom": "~19.0.0",
    "react-force-graph-2d": "~1.27.0",
    "seedrandom": "3.0.5",
    "zod": "~3.24.1",
    "zustand": "~5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "~1.9.4",
    "@google/genai": "~2.4.0",
    "@playwright/test": "~1.49.1",
    "@tailwindcss/vite": "~4.0.0-beta.7",
    "@testing-library/react": "~16.1.0",
    "@types/node": "~22.13.0",
    "@types/react": "~19.0.2",
    "@types/react-dom": "~19.0.2",
    "@types/seedrandom": "~3.0.8",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "~4.3.4",
    "@vitest/coverage-v8": "~2.1.8",
    "concurrently": "~9.1.0",
    "eslint": "~9.17.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "~5.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "~25.0.1",
    "tailwindcss": "~4.0.0-beta.7",
    "tsx": "~4.19.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "~8.19.0",
    "vite": "~6.0.5",
    "vitest": "~2.1.8"
  }
}
